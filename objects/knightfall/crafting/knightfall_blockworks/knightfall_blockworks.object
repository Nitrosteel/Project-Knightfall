{
	"objectName" : "knightfall_blockworks",
    "colonyTags" : [ "knightfall", "knightfall_crafting", "crafting" ],
	"shortdescription" : "^#66ccff;[KF]^reset; Blocks Workbench",
	"description" : "A workstation equipped with a stamping press, furnace, and tools for crafting Knightfall blocks.",
	
	"rarity" : "Rare",
	"price" : 10000,
	"printable" : false,
	"race" : "generic",
	"category" : "crafting",
	//"tooltipKind" : "knightfall_base",
	
	"apexDescription" : "A decent setup, though I would prefer a fully automated production line.",
	"avianDescription" : "A forge without a smith's hammer? Hm. I suppose this stamping press serves much the same purpose.",
	"floranDescription" : "Floran like machine. Machine make building for Floran!",
	"glitchDescription" : "Curious. I wonder if I could manufacture replacement parts for myself using this station.",
	"humanDescription" : "I could use this to build myself a nice steel house!",
	"hylotlDescription" : "Functional, if somewhat crude. I suppose there is merit in such practical craftsmanship.",
	"novakidDescription" : "Now we're talkin'! I can't wait to use this thing to soup up my ship!",
	
	"lightColor" : [36, 77, 139],

	"inventoryIcon" : "icon.png",
	
	"interactAction": "OpenCraftingInterface",
