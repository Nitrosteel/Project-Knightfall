{
	"globalTagDefaults": {
		"paletteSwaps": ""
	},

	"animatedParts": {
		"stateTypes": {
			"firing": {
				"default": "off",
				"states": {
					"off": {},
					"fire": {
						"frames": 2,
						"cycle": 0.09,
						"mode": "transition",
						"transition": "off"
					}
				}
			},
			
			"body": {
				"default": "idle",
				"states": {
					"idle": {
						"frames": 1,
						"cycle": 1,
						"mode": "loop"
					},
					
					"buffer": {
						"frames": 1,
						"cycle": 0.5,
						"mode": "transition",
						"transition": "open",
						"frameProperties":{
							"immediateSound":[]
						}
					},
					
					"open": {
						"frames": 1,
						"cycle": 0.5,
						"mode": "transition",
						"transition": "reload",
						"frameProperties":{
							"immediateSound":[ "/sfx/gun/reload/rocket_reload_clip1.ogg" ]
						}
					},
					
					"reload": {
						"frames": 3,
						"cycle": 0.225,
						"mode": "transition",
						"transition": "closebuffer",
						"frameProperties":{
							"immediateSound":[ "/sfx/gun/reload/grenade_reload_clip1.ogg" ]
						}
					},
					
					"closebuffer": {
						"frames": 1,
						"cycle": 0.5,
						"mode": "transition",
						"transition": "close",
						"frameProperties":{
							"immediateSound":[ ]
						}
					},
					
					"close": {
						"frames": 1,
						"cycle": 0.25,
						"mode": "transition",
						"transition": "idle",
						"frameProperties":{
							"immediateSound":[ "/sfx/gun/reload/ar_reload_clip3.ogg" ]
						}
					}
				}
			}
		},

		"parts": {
			"middle": {
				"properties": {
					"centered": true,
					"offset": [0.0625, 0.6875],
					"zLevel": 1,
					"transformationGroups": ["weapon"]
				},
				
				"partStates": {
					"body": {
						"idle": {
							"properties": {
								"image": "<partImage>:default.<frame><paletteSwaps>"
							}
						},
						
						"buffer": {
							"properties": {
								"image": "<partImage>:default.<frame><paletteSwaps>"
							}
						},
						
						"open": {
							"properties": {
								"image": "<partImage>:open.<frame><paletteSwaps>"
							}
						},
						
						"reload": {
							"properties": {
								"image": "<partImage>:reload.<frame><paletteSwaps>"
							}
						},
						
						"closebuffer": {
							"properties": {
								"image": "<partImage>:close.<frame><paletteSwaps>"
							}
						},
						
						"close": {
							"properties": {
								"image": "<partImage>:default.<frame><paletteSwaps>"
							}
						}
					}
				}
			},
			
			"muzzleFlash": {
				"properties": {
					"zLevel": -1,
					"centered": true,
					"offset": [0, 0],
					"fullbright": true,
					"transformationGroups": ["muzzle"]
				},

				"partStates": {
					"firing": {
						"fire": {
							"properties": {
								"image": "<partImage>:<variant>.<frame>"
							}
						}
					}
				}
			}
		}
	},

	"rotationGroups": {
		"weapon": {
			"angularVelocity": 0
		}
	},

	"transformationGroups": {
		"weapon": {},
		"muzzle": {}
	},

	"particleEmitters": {
		"muzzleFlash": {
			"burstCount": 6,
			"transformationGroups" : ["muzzle"],
			"particles": [
				{ "particle": "rocketbarrelpuff", "offset": [-0.375, 0.0] }
			]
		}
	},

	"lights": {
		"muzzleFlash": {
			"active": false,
			"position": [0, 0],
			"color": [0, 0, 0]
		}
	},

	"sounds": {
		"fire": [ "/sfx/gun/grenade1.ogg" ]
	}
}