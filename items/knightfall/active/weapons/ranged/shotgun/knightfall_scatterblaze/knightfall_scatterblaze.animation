{
	"globalTagDefaults": {
		"paletteSwaps": ""
	},

	"animatedParts": {
		"stateTypes": {
			"firing": {
				"default": "off",
				"states": {
					"off": {},
					"fire": {
						"frames": 1,
						"cycle": 0.02,
						"mode": "transition",
						"transition": "off"
					}
				}
			},
			
			"body": {
				"default": "idle",
				"states": {
					"idle": {
						"frames": 1,
						"cycle": 1,
						"mode": "loop"
					},
					
					"reload": {
						"frames": 4,
						"cycle": 0.25,
						"mode": "transition",
						"transition": "idle",
						"frameProperties":{
							"immediateSound":[ "/sfx/interface/mech_energy_refill.ogg" ]
						}
					},
					
					"launcher_open": {
						"frames": 2,
						"cycle": 0.15,
						"mode": "transition",
						"transition": "launcher_openbuffer",
						"frameProperties":{
							"immediateSound":[ "/sfx/gun/reload/rocket_reload_clip1.ogg" ]
						}
					},
					
					"launcher_openbuffer": {
						"frames": 1,
						"cycle": 0.5,
						"mode": "transition",
						"transition": "launcher_reload",
						"frameProperties":{
							"immediateSound":[]
						}
					},
					
					"launcher_reload": {
						"frames": 3,
						"cycle": 0.225,
						"mode": "transition",
						"transition": "launcher_closebuffer",
						"frameProperties":{
							"immediateSound":[ "/sfx/gun/reload/grenade_reload_clip1.ogg" ]
						}
					},
					
					"launcher_closebuffer": {
						"frames": 1,
						"cycle": 0.35,
						"mode": "transition",
						"transition": "launcher_close",
						"frameProperties":{
							"immediateSound":[ ]
						}
					},
					
					"launcher_close": {
						"frames": 2,
						"cycle": 0.15,
						"mode": "transition",
						"transition": "idle",
						"frameProperties":{
							"immediateSound":[ "/sfx/gun/reload/ar_reload_clip3.ogg" ]
						}
					}
				}
			}
		},

		"parts": {
			"middle": {
				"properties": {
					"centered": true,
					"offset": [1.3125, 0.4375],
					"zLevel": 1,
					"transformationGroups": ["weapon"]
				},
				
				"partStates": {
					"body": {
						"idle": {
							"properties": {
								"image": "<partImage>:default.<frame><paletteSwaps>"
							}
						},
						
						"reload": {
							"properties": {
								"image": "<partImage>:reload.<frame><paletteSwaps>"
							}
						},
						
						"launcher_open": {
							"properties": {
								"image": "<partImage>:launcher_open.<frame><paletteSwaps>"
							}
						},
						
						"launcher_openbuffer": {
							"properties": {
								"image": "<partImage>:launcher_openbuffer.<frame><paletteSwaps>"
							}
						},
						
						"launcher_reload": {
							"properties": {
								"image": "<partImage>:launcher_reload.<frame><paletteSwaps>"
							}
						},
						
						"launcher_closebuffer": {
							"properties": {
								"image": "<partImage>:launcher_closebuffer.<frame><paletteSwaps>"
							}
						},
						
						"launcher_close": {
							"properties": {
								"image": "<partImage>:launcher_close.<frame><paletteSwaps>"
							}
						}
					}
				}
			},
			
			"middlefullbright": {
				"properties": {
					"centered": true,
					"offset": [1.3125, 0.4375],
					"zLevel": 2,
					"transformationGroups": ["weapon"],
					"fullbright": true
				},
				"partStates": {
					"body": {
						"idle": {
							"properties": {
								"image": "<partImage>:default.<frame><paletteSwaps>"
							}
						},
						
						"reload": {
							"properties": {
								"image": "<partImage>:reload.<frame><paletteSwaps>"
							}
						},
						
						"launcher_open": {
							"properties": {
								"image": "<partImage>:launcher_open.<frame><paletteSwaps>"
							}
						},
						
						"launcher_openbuffer": {
							"properties": {
								"image": "<partImage>:launcher_openbuffer.<frame><paletteSwaps>"
							}
						},
						
						"launcher_reload": {
							"properties": {
								"image": "<partImage>:launcher_reload.<frame><paletteSwaps>"
							}
						},
						
						"launcher_closebuffer": {
							"properties": {
								"image": "<partImage>:launcher_closebuffer.<frame><paletteSwaps>"
							}
						},
						
						"launcher_close": {
							"properties": {
								"image": "<partImage>:launcher_close.<frame><paletteSwaps>"
							}
						}
					}
				}
			},
			
			"muzzleFlash": {
				"properties": {
					"zLevel": -1,
					"centered": true,
					"offset": [0, 0],
					"fullbright": true,
					"transformationGroups": ["muzzle"]
				},

				"partStates": {
					"firing": {
						"fire": {
							"properties": {
								"image": "<partImage>:<variant>.<frame>"
							}
						}
					}
				}
			}
		}
	},

	"rotationGroups": {
		"weapon": {
			"angularVelocity": 0
		}
	},

	"transformationGroups": {
		"weapon": {},
		"muzzle": {}
	},

	"particleEmitters": {
		"muzzleFlash" : {
			"transformationGroups" : ["muzzle"],
			"particles" : [
				{ "particle" : "knightfall_shotgunshell", "offset" : [-3.625, -0.1] }
			]
		},
		"altMuzzleFlash" : {
			"transformationGroups" : ["muzzle"],
			"offsetRegion" : [0, 0, 0, 0],
			"particles" : [
				{ "particle" : "rocketbarrelpuff", "offset" : [-1.0, -1.0] },
				{ "particle" : "rocketbarrelpuff", "offset" : [-1.0, -1.0] },
				{ "particle" : "rocketbarrelpuff", "offset" : [-1.0, -1.0] }
			]
		}
	},

	"lights": {
		"muzzleFlash": {
			"transformationGroups": ["muzzle"],
			"color": [200, 150, 50]
		}
	},

	"sounds": {
		"fire": [ "/sfx/gun/knightfall_shotgun-fire1.ogg", "/sfx/gun/knightfall_shotgun-fire3.ogg" ],
		"altFire": [ "/sfx/gun/grenade1.ogg" ]
	}
}