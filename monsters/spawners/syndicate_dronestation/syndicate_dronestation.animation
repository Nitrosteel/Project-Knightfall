				"position" : [0, 0],
				"initialVelocity" : [6, 8.0],
				"finalVelocity" : [6, -8.0],
				"approach" : [0, 20],
				"timeToLive" : 0.9,
				"layer" : "front",
				"collidesForeground" : true,
				"variance" : {
				  "initialVelocity" : [7, 4.0]
