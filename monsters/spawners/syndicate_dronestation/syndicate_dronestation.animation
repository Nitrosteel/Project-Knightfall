				"layer" : "middle",
				"variance" : {
				  "size" : 1.5,
				  "initialVelocity" : [10, 10],
				  "timeToLive" : 1
				}
			}
		},
		{
			"particle" : {
				"type" : "ember",
				"size" : 0.5,
				"color" : [218, 46, 2, 255],
				"light" : [128, 0, 0],
				"fullbright" : true,
				"destructionTime" : 0.25,
				"destructionAction" : "shrink",
				"initialVelocity" : [0, 20],
				"finalVelocity" : [0.0, -100.0],
				"approach" : [0, 40],
				"timeToLive" : 1,
				"layer" : "middle",
				"variance" : {
				  "size" : 0.75,
				  "initialVelocity" : [10, 10],
				  "timeToLive" : 1
				}
			}
		},
		{
			"particle" : {
				"type" : "ember",
				"size" : 0.5,
				"color" : [218, 46, 2, 255],
				"light" : [128, 0, 0],
				"fullbright" : true,
				"destructionTime" : 0.25,
				"destructionAction" : "shrink",
				"initialVelocity" : [0, 20],
				"finalVelocity" : [0.0, -100.0],
				"approach" : [0, 40],
				"timeToLive" : 1,
				"layer" : "middle",
				"variance" : {
				  "size" : 0.75,
				  "initialVelocity" : [10, 10],
				  "timeToLive" : 1
				}
			}
		},
		{
			"particle" : {
				"type" : "ember",
				"size" : 3,
				"color" : [253, 209, 77, 255],
				"light" : [128, 0, 0],
				"fullbright" : true,
				"destructionTime" : 0.5,
				"destructionAction" : "shrink",
				"fade" : 0.9,
				"initialVelocity" : [0, 5],
				"finalVelocity" : [0.0, -50.0],
				"approach" : [0, 30],
				"timeToLive" : 0.2,
				"layer" : "middle",
				"variance" : {
					"position" : [0.25, 0.25],
