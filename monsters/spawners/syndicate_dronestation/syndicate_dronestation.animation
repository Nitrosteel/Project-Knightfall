{
  "animatedParts" : {
    "stateTypes" : {
      "body" : {
        "priority" : 0,
        "default" : "idle",
        "states" : {
          "idle" : {
            "frames" : 24,
            "cycle" : 1.8,
            "mode" : "loop"
          }
        }
      },
	  "damage" : {
        "priority" : 3,
        "default" : "none",
        "states" : {
          "none" : {
            "frames" : 1
          },
          "stunned" : {
            "frames" : 1
          }
        }
      },
      "releaseParticles" : {
        "default" : "off",
        "states" : {
          "off" : {
            "frames" : 1,
            "properties" : {
              "particleEmittersOff" : [ "releaseParticles" ]
            }
          },
          "on" : {
            "frames" : 1,
            "cycle" : 0.1,
            "mode" : "transition",
            "transition" : "off",
            "properties" : {
              "particleEmittersOn" : [ "releaseParticles" ]
            }
          }
        }
      }
    },

    "parts" : {
      "body" : {
        "properties" : {
          "transformationGroups" : [ "body" ],
          "offset" : [0, 1.25]
        },
        "partStates" : {
          "body" : {
            "idle" : {
              "properties" : {
                "image" : "<partImage>:idle.<frame>"
              }
            }
          },
		  "damage" : {
            "stunned" : {
              "properties" : {
                "image" : "<partImage>:idle.<frame>"
              }
            }
          }
        }
      }
    }
  },

  "transformationGroups" : {
    "body" : { "interpolated" : true }
  },

  "effects" : {
    "blink" : {
      "type" : "flash",
      "time" : 0,
      "directives" : "fade=ffffff;0.5"
    }
  },

  "particleEmitters" : {
    "deathPoof" : {
	  "burstCount" : 12,
	  "offsetRegion" : [-3.5, -1.25, 3.5, 1.25],
      "particles" : [
		{
			"particle" : {
				"type" : "animated",
				"animation" : "/animations/smoke/smoke.animation",
				"approach" : [0.5, 0.5],
				"timeToLive" : 0.6,
				"variance" : {
					"position" : [5, 5],
					"initialVelocity" : [1, 1],
					"timeToLive" : 0.15,
					"rotation" : 180
				}
			}
		},
		{
			"particle" : {
				"type" : "animated",
				"animation" : "/animations/knightfall_flamemedium/knightfall_flamemedium.animation",
				"fullbright" : true,
				"approach" : [0.5, 0.5],
				"size" : 1,
				"timeToLive" : 0.6,
				"layer" : "middle",
				"variance" : {
					"position" : [5, 5],
					"initialVelocity" : [1, 1],
					"size" : 1.5,
